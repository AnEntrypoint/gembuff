# Copy to .env (git-ignored) and fill in only the methods you use.
# Nothing here is a secret; the real values go only in .env.

# 01 AI Studio API key (free tier). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 04 OAuth desktop client you created in Google Cloud Console (free).
GEMBUFF_OAUTH_CLIENT_ID=
GEMBUFF_OAUTH_CLIENT_SECRET=

# 06 Service account key file, kept outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# 07 Workload Identity Federation external_account config file.
GOOGLE_EXTERNAL_ACCOUNT_CONFIG=

# Optional: project used for x-goog-user-project and quota.
GOOGLE_CLOUD_PROJECT=
